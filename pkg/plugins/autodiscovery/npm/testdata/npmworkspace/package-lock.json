{
  "name": "workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace",
      "version": "0.1.0",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/app": {
      "resolved": "packages/app",
      "link": true
    },
    "node_modules/axios": {
      "version": "1.2.6",
      "resolved": "https://registry.npmjs.org/axios/-/axios-1.2.6.tgz"
    },
    "packages/app": {
      "name": "app",
      "version": "0.1.0",
      "dependencies": {
        "axios": "^1.0.0"
      }
    }
  }
}
